# =============================================================================
# II decentralized coordinator
# =============================================================================
HOST=0.0.0.0
PORT=8787
II_DB_PATH=./network/data/ii-network.db
ALLOWED_ORIGINS=http://localhost:8080
TRUST_PROXY=1
PUBLIC_WEB_URL=http://localhost:8787
II_ADMIN_API_TOKEN=replace-with-a-long-random-admin-secret
ADMIN_EXPORT_TOKEN=replace-with-a-long-random-export-secret

# Cryptographic release trust and encrypted durable work
II_RELEASE_PUBLIC_KEY=
II_ALLOW_UNSIGNED_HOSTS=false
II_DATA_ENCRYPTION_KEY=
II_JOB_API_TOKEN=
II_TEACHING_API_TOKEN=
II_JOB_LEASE_MS=90000

# Dodo Payments
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_MONTHLY_PRODUCT_ID=
DODO_YEARLY_PRODUCT_ID=
DODO_TIER2_COUNTRIES=BR,ID,PH,TR,ZA,MX,MY,TH,VN
DODO_CONFIGURE_DRY_RUN=false
# DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com
DODO_MONTHLY_URL=
DODO_YEARLY_URL=

# =============================================================================
# Electron worker
# =============================================================================
II_COORDINATOR_URL=http://localhost:8787
II_HOST_COUNTRY=IN
II_MODEL_MANIFEST_ID=
II_RELEASE_PUBLIC_KEY=
II_ARTIFACT_ID=worker-q4
# II_EXPERT_ID=0
II_EXPERT_MAX_BYTES=2147483648
II_EXPERT_DOWNLOAD_TIMEOUT_MS=1800000
II_INFERENCE_PORT=7777
II_PUBLIC_INFERENCE_URL=

# Disabled legacy migration path; unsigned artifacts never count as verified.
II_ALLOW_LEGACY_ARTIFACT=false
II_EXPERT_SOURCE_URL=
II_EXPERT_SHA256=
II_INFERENCE_MODEL_PATH=
