# Coordinator and host identity
II_COORDINATOR_URL=http://localhost:8787
II_HOST_COUNTRY=IN

# Required signed model release. Obtain these from the II release operator;
# never trust a manifest merely because it has a signature—the publisher key
# must match this independently distributed key.
II_MODEL_MANIFEST_ID=
II_RELEASE_PUBLIC_KEY=
# Select by artifact ID, or for expert manifests by expert number.
II_ARTIFACT_ID=worker-q4
# II_EXPERT_ID=0

# Storage safety ceiling and resumable-download timeout.
II_EXPERT_MAX_BYTES=2147483648
II_EXPERT_DOWNLOAD_TIMEOUT_MS=1800000

# node-llama-cpp executes complete compatible GGUF workers. Raw safetensors
# can be stored and reported but are never marked inference-ready by this runtime.
II_INFERENCE_PORT=7777
II_PUBLIC_INFERENCE_URL=

# Unsafe migration mode only. Legacy artifacts are stored but cannot become a
# manifest-verified routable worker.
II_ALLOW_LEGACY_ARTIFACT=false
II_EXPERT_SOURCE_URL=
II_EXPERT_SHA256=
II_INFERENCE_MODEL_PATH=
