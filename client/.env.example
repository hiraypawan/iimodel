# Coordinator registration
II_COORDINATOR_URL=http://localhost:8787
II_HOST_COUNTRY=IN

# One real expert artifact (v0.2 defaults to expert 0)
II_EXPERT_ID=0
II_EXPERT_SOURCE_URL=https://models.example.com/expert-0.safetensors
# Strongly recommended in production:
II_EXPERT_SHA256=
# 2 GiB safety ceiling and 30-minute timeout:
II_EXPERT_MAX_BYTES=2147483648
II_EXPERT_DOWNLOAD_TIMEOUT_MS=1800000

# node-llama-cpp executes GGUF, not raw safetensors. Point this at a compatible
# local GGUF model to enable real POST /infer responses. Without it, /infer is
# available but honestly returns HTTP 503 "expert not loaded yet".
II_INFERENCE_MODEL_PATH=
II_INFERENCE_PORT=7777

# Advertise an externally reachable endpoint only after real inference loads.
# HTTPS is required except for localhost integration tests.
II_PUBLIC_INFERENCE_URL=
