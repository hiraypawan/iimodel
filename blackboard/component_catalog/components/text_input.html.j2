<div class="ii-field">
  <label for="{{ field_id|e }}">{{ label|e }}</label>
  <input id="{{ field_id|e }}" name="{{ name|e }}" type="text" value="{{ value|default('', true)|e }}"{% if placeholder|default('') %} placeholder="{{ placeholder|e }}"{% endif %}{% if required|default(false) %} required{% endif %}>
</div>
