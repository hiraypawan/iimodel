# Coordinator
HOST=0.0.0.0
PORT=8787
II_DB_PATH=./data/ii-network.db
ALLOWED_ORIGINS=http://localhost:8080
# Set to 1 when exactly one trusted reverse proxy (for example Cloudflare) fronts the app.
TRUST_PROXY=1
PUBLIC_WEB_URL=http://localhost:8787

# Required to access GET /admin/genesis
ADMIN_EXPORT_TOKEN=replace-with-a-long-random-secret

# Dodo Payments: API-created checkout sessions
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_MONTHLY_PRODUCT_ID=
DODO_YEARLY_PRODUCT_ID=
DODO_TIER2_COUNTRIES=BR,ID,PH,TR,ZA,MX,MY,TH,VN
# Set true to preview `npm run configure:dodo` without writing changes.
DODO_CONFIGURE_DRY_RUN=false
# Optional API override for local integration tests only:
# DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com

# Or use pre-created Dodo payment links instead of the API:
DODO_MONTHLY_URL=
DODO_YEARLY_URL=
