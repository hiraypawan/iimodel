# Coordinator
HOST=0.0.0.0
PORT=8787
II_DB_PATH=./data/ii-network.db
ALLOWED_ORIGINS=http://localhost:8080
# Set to 1 only when exactly one trusted reverse proxy fronts the app.
TRUST_PROXY=1
PUBLIC_WEB_URL=http://localhost:8787

# Host and release trust
# Generate with: npm run keygen:release -- ./release-key.pem
II_RELEASE_PUBLIC_KEY=
# Signed hosts are mandatory by default. Legacy unsigned mode is unsafe and is
# available only for a short local migration.
II_ALLOW_UNSIGNED_HOSTS=false

# Encrypts durable prompts, results, and approved teaching intake at rest.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
II_DATA_ENCRYPTION_KEY=
II_JOB_API_TOKEN=
II_TEACHING_API_TOKEN=
II_JOB_LEASE_MS=90000

# Separate administrative and data-export credentials.
II_ADMIN_API_TOKEN=replace-with-a-long-random-admin-secret
ADMIN_EXPORT_TOKEN=replace-with-a-long-random-export-secret

# Dodo Payments: API-created checkout sessions
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_MONTHLY_PRODUCT_ID=
DODO_YEARLY_PRODUCT_ID=
DODO_TIER2_COUNTRIES=BR,ID,PH,TR,ZA,MX,MY,TH,VN
DODO_CONFIGURE_DRY_RUN=false
# DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com

# Or use pre-created Dodo payment links:
DODO_MONTHLY_URL=
DODO_YEARLY_URL=
