# =============================================================================
# .gitignore -- II v2.0 local-agent prototype
# =============================================================================

# --- Virtual environments (NEVER commit) ---
.venv/
.venv311/
venv/
venv3/
venv311/
env/
.env

# --- Large binaries / archives (DO NOT COMMIT) ---
models/
*.gguf
*.safetensors
*.bin
*.zip
*.tar
*.tar.gz
*release-key*.pem
*.part

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt

# --- II state / runtime ---
.ii_state/
.ii_server.pid
self_tools/
.blackboard.json
.cache/
dist/
tests/benchmarks/results/
*.egg-info/
.installed.cfg
*.egg

# --- Scratch / generated dumps ---
current_files.txt
current_list.txt
tmp_*.txt

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Node / Electron ---
node_modules/
network/data/
client/.ii-test/

# --- Logs ---
*.log
npm-debug.log*
